VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# PostHog product analytics (project 734175). Analytics stays off if either is blank.
# Put the real project token in .env.local (git-ignored), never in this file.
# Host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU), matching the project region.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Optional: set to true on team/test deployments so events carry test_mode=true.
VITE_POSTHOG_TEST_MODE=
